{
	email {$ACME_EMAIL}
	admin localhost:2019
}

(private_logs) {
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}
}

# Bound web drain (10s), API replacement (20s + 30s) and web startup (20s).
(upstream_retry) {
	lb_try_duration 100s
	lb_try_interval 250ms
}

{$GAME_FEEDBACK_DOMAIN} {
	import private_logs
	request_body {
		max_size 27MB
	}
	@internal path_regexp internal (?i)^/(?:_internal(?:/|$)|api/auth/(?:demo|test-)|api/admin(?:/|$))
	route {
		respond @internal "edge-blocked" 404
		handle /api/* {
			reverse_proxy gf-api:4300 {
				flush_interval -1
				import upstream_retry
			}
		}
		handle {
			reverse_proxy gf-web:3300 {
				flush_interval -1
				import upstream_retry
			}
		}
	}
}

{$PHOTO_CONTEST_DOMAIN} {
	import private_logs
	request_body {
		max_size 110MB
	}
	@internal path_regexp internal (?i)^/(?:_internal(?:/|$)|backend/testing(?:/|$))
	@graphql path_regexp graphql (?i)^/backend/graphql/?$
	route {
		respond @internal "edge-blocked" 404
		handle @graphql {
			rewrite * /backend/graphql
			reverse_proxy pc-web:3200 {
				import upstream_retry
			}
		}
		handle_path /backend/* {
			reverse_proxy pc-api:4200 {
				flush_interval -1
				import upstream_retry
			}
		}
		handle {
			reverse_proxy pc-web:3200 {
				flush_interval -1
				import upstream_retry
			}
		}
	}
}
