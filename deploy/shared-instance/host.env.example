# /srv/side-project/.env, chmod 600. Compose reads this file; do not source it.
GAME_FEEDBACK_DOMAIN=game.bambyul.com
GAME_FEEDBACK_API_DOMAIN=api.game.bambyul.com
PHOTO_CONTEST_DOMAIN=contest.bambyul.com
PHOTO_CONTEST_API_DOMAIN=api.contest.bambyul.com
ACME_EMAIL=contact@bambyul.com
# Both services share one private bucket and keep files under game-feedback/production/ and photo-contest/production/.
GAME_FEEDBACK_S3_BUCKET=your-private-media-bucket
PHOTO_CONTEST_S3_BUCKET=your-private-media-bucket
# pg-backup.sh uploads a dump here before every migration (EC2 role, PutObject under postgres/ only).
BACKUP_BUCKET=your-database-backup-bucket
BACKUP_REGION=ap-northeast-2
