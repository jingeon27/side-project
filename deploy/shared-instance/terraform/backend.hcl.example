# backend.hcl로 복사해 실제 값을 넣는다(backend.hcl은 .gitignore 대상).
#   terraform init -backend-config=backend.hcl
# state 버킷은 이 구성 밖에서 먼저 만든다. README.md의 "state 버킷 준비"를 따른다.
bucket       = "your-terraform-state-bucket"
key          = "side-project/shared-instance/terraform.tfstate"
region       = "ap-northeast-2"
encrypt      = true
use_lockfile = true
