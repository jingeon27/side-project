# terraform.tfvars로 복사해 값을 넣는다(terraform.tfvars는 .gitignore 대상). 비밀은 넣지 않는다.
# 주석 처리한 값은 기본값이다. 각 변수의 설명과 검증 규칙은 variables.tf에 있다.

# 필수: media는 두 서비스가 폴더로 나눠 쓰는 기존 비공개 버킷이다(Terraform이 만들지 않는다).
# backup은 배포 전 DB 덤프용으로 Terraform이 새로 만든다(전역 고유, 만든 뒤 바꾸면 버킷이 교체된다).
media_bucket_name  = "your-existing-private-media-bucket"
backup_bucket_name = "your-database-backup-bucket"

# 권장: 운영 계정에서만 적용되게 한다.
# allowed_account_ids = ["123456789012"]

# 서비스 도메인. API는 api.<도메인>이다.
# game_feedback_domain = "game.bambyul.com"
# photo_contest_domain = "contest.bambyul.com"

# Route 53 호스팅 영역이 있으면 네 호스트의 A 레코드를 만든다. 비우면 dns_records 출력대로 직접 만든다.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# SSH. 비워 두면 22번을 열지 않고 SSM Session Manager로 접속한다.
# GitHub-hosted runner의 SSH 배포를 쓰려면 runner가 접속할 수 있게 열어야 한다(README "SSH와 배포 runner").
# ssh_allowed_cidrs = ["203.0.113.10/32"]
# ssh_public_key    = "ssh-ed25519 AAAA... operator@example"

# pg-backup.sh는 --network host로 aws-cli를 실행하므로 기본 1로 덤프를 올릴 수 있다(variables.tf 설명 참고).
# metadata_hop_limit = 1

# CloudWatch 알람 메일. 비워 두면 상태 검사 실패 시 재부팅만 하고 알리지 않는다.
# alarm_email                = "operator@example.com"
# cpu_credit_alarm_threshold = 30

# 비용에 영향을 주는 값
# 메모리가 모자라면(swap 증가·OOMKilled) t3.medium으로 올린다. PostgreSQL 볼륨은 그대로 남는다.
# instance_type                        = "t3.small"
# instance_cpu_credits                 = "standard"
# root_volume_size_gib                 = 30
# swap_size_gib                        = 2
# postgres_volume_size_gib             = 20
# postgres_snapshot_time               = "17:00"
# postgres_snapshot_retention_count    = 7
# postgres_dump_retention_days         = 30
# s3_noncurrent_version_retention_days = 30

# 처음 만든 뒤 바꾸지 않는 값(바꾸면 리소스가 교체된다)
# name_prefix        = "side-shared"
# vpc_cidr           = "10.40.0.0/16"
# availability_zone  = "ap-northeast-2a"
