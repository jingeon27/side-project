{
  "name": "side",
  "private": true,
  "packageManager": "yarn@4.17.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "projects/*",
    "projects/*/apps/*",
    "projects/*/packages/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/install-git-hooks.mjs",
    "dev:photo-contest": "yarn workspace @side/photo-contest dev",
    "build": "yarn workspaces foreach -A --include \"@side/*\" run build",
    "build:photo-contest": "yarn workspace @side/photo-contest build",
    "typecheck": "yarn workspaces foreach -A --include \"@side/*\" run typecheck",
    "test": "yarn workspaces foreach -A --include \"@side/*\" run test",
    "test:photo-contest": "yarn workspace @side/photo-contest test",
    "test:photo-contest:e2e": "yarn workspace @side/photo-contest test:e2e",
    "check": "yarn workspaces foreach -A --include \"@side/*\" run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "yarn workspace @side/design-system storybook",
    "build:storybook": "yarn workspace @side/design-system build-storybook",
    "test:photo-contest:unit": "yarn workspace @side/photo-contest test:unit",
    "test:photo-contest:api": "yarn workspace @side/photo-contest test:api",
    "dev:game-feedback": "yarn workspace @side/game-feedback dev",
    "dev:game-feedback:demo": "yarn workspace @side/game-feedback dev:demo",
    "setup:game-feedback": "yarn workspace @side/game-feedback setup",
    "build:game-feedback": "yarn workspace @side/game-feedback build",
    "test:game-feedback": "yarn workspace @side/game-feedback test",
    "check:game-feedback": "yarn workspace @side/game-feedback check"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.0"
  },
  "dependenciesMeta": {
    "@embedded-postgres/darwin-arm64": {
      "built": true
    },
    "@embedded-postgres/darwin-x64": {
      "built": true
    },
    "@embedded-postgres/linux-arm64": {
      "built": true
    },
    "@embedded-postgres/linux-x64": {
      "built": true
    },
    "@embedded-postgres/windows-x64": {
      "built": true
    }
  },
  "resolutions": {
    "@apollo/client-react-streaming@npm:0.14.5": "patch:@apollo/client-react-streaming@npm%3A0.14.5#~/.yarn/patches/@apollo-client-react-streaming-npm-0.14.5-7738a89319.patch",
    "@graphql-tools/utils@npm:12.0.1": "npm:12.0.3",
    "zod@npm:^4.1.12": "patch:zod@npm%3A4.6.7#~/.yarn/patches/zod-npm-4.6.7-93f9f3c3ad.patch",
    "zod@npm:^4.4.3": "patch:zod@npm%3A4.6.7#~/.yarn/patches/zod-npm-4.6.7-93f9f3c3ad.patch"
  }
}
