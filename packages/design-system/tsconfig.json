{
  "extends": "@side/config/typescript",
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts", "*.mts", ".storybook/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
