NODE_ENV=development
DATABASE_URL=postgresql://contest:contest@127.0.0.1:55432/photo_contest?schema=public
WEB_ORIGIN=http://localhost:3200
API_URL=http://127.0.0.1:4200
# API 포트 4200과 전달 헤더 비신뢰는 코드 기본값을 사용한다.
LOCAL_POSTGRES_PORT=55432
# db:test:local로 별도 포트·저장 폴더의 테스트 전용 DB를 시작한다.
LOCAL_TEST_POSTGRES_PORT=55434
# 테스트마다 격리 스키마를 만들고 끝나면 지운다. loopback·LOCAL_TEST_POSTGRES_PORT·photo_contest_test만 허용하며 개발 DB로 대신하지 않는다.
TEST_DATABASE_URL=postgresql://contest:contest@127.0.0.1:55434/photo_contest_test?schema=public

# 아이디·비밀번호와 익명 세션을 사용한다. 소셜 로그인 설정은 없다.
# 미디어는 항상 private S3 호환 버킷에 둔다. 로컬은 test-kit S3 대역을 쓰며 dev가 함께 띄운다
# (따로 실행: yarn workspace @photo-contest/test-kit s3, 객체는 .data/s3). 대역의 자격 증명은 로컬 전용 값이다.
# 실제 버킷을 시험하려면 아래를 실제 값으로 바꾸고 S3_ENDPOINT를 비우면 대역을 띄우지 않는다.
S3_BUCKET=photo-contest-dev
S3_ENDPOINT=http://127.0.0.1:4210
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Optional object path, e.g. game-feedback/photo-contest. Keep the bucket name separate.
S3_KEY_PREFIX=
AWS_ACCESS_KEY_ID=photo-contest-dev
AWS_SECRET_ACCESS_KEY=photo-contest-dev-secret
# 비워두면 외부 관측 서비스로 전송하지 않습니다.
NEXT_PUBLIC_AMPLITUDE_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# 모바일도 루트 .env의 WEB_ORIGIN과 공개 관측 키를 사용한다. 서버 자격 증명은 앱에 넣지 않는다.

# Native push: enable only after app EAS project and FCM/APNs credentials are configured.
PUSH_NOTIFICATIONS_ENABLED=false
# Server only; enable enhanced push security in the Expo dashboard before setting this token.
EXPO_ACCESS_TOKEN=
