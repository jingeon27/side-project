NODE_ENV=development
DATABASE_URL=postgresql://contest:contest@127.0.0.1:55432/photo_contest?schema=public
WEB_ORIGIN=http://localhost:3200
API_URL=http://127.0.0.1:4200
PORT=4200
LOCAL_POSTGRES_PORT=55432
STORAGE_DIR=.data/photos
# 로컬에서만 사용. 운영에서는 반드시 false.
ENABLE_DEV_LOGIN=true
# 선택: 각 provider의 callback URL을 아래 형식으로 등록
# http://localhost:3200/backend/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 운영에서 S3/R2/MinIO 같은 private 버킷을 선택할 수 있습니다.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 비워두면 외부 관측 서비스로 전송하지 않습니다.
AMPLITUDE_API_KEY=
AMPLITUDE_REGION=US
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
