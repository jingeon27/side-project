NODE_ENV=development
DATABASE_URL=postgresql://contest:contest@127.0.0.1:55432/photo_contest?schema=public
WEB_ORIGIN=http://localhost:3200
API_URL=http://127.0.0.1:4200
# API 포트 4200과 전달 헤더 비신뢰는 코드 기본값을 사용한다.
LOCAL_POSTGRES_PORT=55432
# db:test:local로 별도 포트·저장 폴더의 테스트 전용 DB를 시작한다.
LOCAL_TEST_POSTGRES_PORT=55434
# 테스트마다 격리 스키마를 만들고 끝나면 지운다. loopback·LOCAL_TEST_POSTGRES_PORT·photo_contest_test만 허용하며 개발 DB로 대신하지 않는다.
TEST_DATABASE_URL=postgresql://contest:contest@127.0.0.1:55434/photo_contest_test?schema=public

# 아이디·비밀번호와 익명 세션을 사용한다. 소셜 로그인 설정은 없다.
# 로컬 개발·통합 테스트도 기존 private AWS S3 버킷을 사용한다. 별도 저장소 서버·버킷을 만들지 않는다.
# 버킷 CORS에 로컬 웹과 브라우저 테스트의 Origin을 허용한다.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_FORCE_PATH_STYLE=false
# 선택: 버킷 안의 객체 경로이며 버킷 이름은 넣지 않는다. 공용 버킷의 로컬 개발·테스트는 photo-contest/local을 쓴다. 로컬 키 권한과 테스트 잔여물 만료 규칙이 이 경로 기준이다.
S3_KEY_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
# 비워두면 외부 관측 서비스로 전송하지 않습니다.
NEXT_PUBLIC_AMPLITUDE_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# 웹 서버·브라우저 오류의 공통 release. 운영 CI가 배포 커밋 SHA를 자동으로 넣는다.
SENTRY_RELEASE=
# 프로젝트 Releases에서 발급한 웹훅 토큰. CI에서만 쓰고 런타임에는 전달하지 않는다.
SENTRY_WEB_RELEASE_TOKEN=
SENTRY_WEB_ORG=photo-content
SENTRY_WEB_PROJECT=photo-contest-web
SENTRY_SERVER_RELEASE_TOKEN=
SENTRY_SERVER_ORG=photo-content
SENTRY_SERVER_PROJECT=photo-contest-server
# 모바일도 루트 .env의 WEB_ORIGIN과 공개 관측 키, 아래 MOBILE_* 빌드 키를 사용한다. 서버 자격 증명은 앱에 넣지 않는다.
# MOBILE_* 키는 앱 빌드(app.config.ts)만 읽는다. 이 템플릿으로 만든 루트 .env는 Git에서 제외해 EAS 원격 빌드에 올라가지 않는다.
# EAS 원격 빌드에는 운영 WEB_ORIGIN과 공개 관측 키, 쓰는 MOBILE_* 키를 EAS 환경변수로 넣는다. 관측 키가 빠지면 빌드는 통과하지만 운영 앱의 오류 수집과 분석이 꺼진다.
# 선택: iOS 강제 업데이트 화면의 App Store 버튼. App Store Connect의 숫자 앱 ID만 넣는다. 비우면 버튼을 숨기고, 형식이 틀리면 앱 빌드가 멈춘다.
MOBILE_IOS_APP_STORE_ID=
# 선택: EAS 프로젝트 UUID. 넣으면 앱이 Expo push token을 받고 웹에 알림 기능을 알린다. 비우면 앱 푸시를 끄고, 형식이 틀리면 앱 빌드가 멈춘다.
MOBILE_EAS_PROJECT_ID=

# Native push: enable only after MOBILE_EAS_PROJECT_ID and FCM/APNs credentials are configured.
PUSH_NOTIFICATIONS_ENABLED=false
# Server only; enable enhanced push security in the Expo dashboard before setting this token.
EXPO_ACCESS_TOKEN=
