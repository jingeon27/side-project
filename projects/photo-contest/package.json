{
  "name": "@side/photo-contest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sentry:check": "yarn workspace @photo-contest/api sentry:check",
    "dev": "node --env-file-if-exists=.env scripts/dev.ts",
    "db:local": "node --env-file-if-exists=.env --import tsx scripts/local-postgres.ts",
    "db:test:local": "node --env-file-if-exists=.env --import tsx scripts/local-postgres.ts --test",
    "db:generate": "yarn workspace @photo-contest/api db:generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/task.ts @photo-contest/api db:migrate",
    "codegen": "yarn workspace @photo-contest/web codegen",
    "build": "node --env-file-if-exists=.env scripts/task.ts @photo-contest/api build && node --env-file-if-exists=.env scripts/task.ts @photo-contest/web build",
    "lint": "eslint . && yarn workspaces foreach -A --include '@photo-contest/*' run lint",
    "typecheck": "tsc7 --project tsconfig.lint.json && yarn workspaces foreach -A -p -j 2 --include '@photo-contest/*' run typecheck",
    "test": "yarn workspaces foreach -A -p -j 2 --include '@photo-contest/*' run test",
    "test:unit": "yarn workspaces foreach -A -p -j 2 --include '@photo-contest/*' run test:unit",
    "test:api": "yarn workspaces foreach -A --include '@photo-contest/*' run test:api",
    "test:e2e": "yarn workspaces foreach -A --include '@photo-contest/*' run test:e2e",
    "check": "yarn lint && yarn typecheck && yarn test"
  },
  "devDependencies": {
    "@side/config": "workspace:*",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "embedded-postgres": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
