{
  "name": "@side/photo-contest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "db:local": "node --env-file-if-exists=.env --import tsx scripts/local-postgres.ts",
    "db:test:local": "node --env-file-if-exists=.env --import tsx scripts/local-postgres.ts --test",
    "db:generate": "yarn workspace @photo-contest/api db:generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/task.mjs @photo-contest/api db:migrate",
    "codegen": "yarn workspace @photo-contest/web codegen",
    "build": "node --env-file-if-exists=.env scripts/task.mjs @photo-contest/api build && node --env-file-if-exists=.env scripts/task.mjs @photo-contest/web build",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.lint.json && yarn workspaces foreach -A -p -j 2 --include '@photo-contest/*' run typecheck",
    "test": "yarn workspaces foreach -A -p -j 2 --include '@photo-contest/*' run test",
    "test:unit": "yarn workspaces foreach -A -p -j 2 --include '@photo-contest/*' run test:unit",
    "test:api": "yarn workspaces foreach -A --include '@photo-contest/*' run test:api",
    "test:e2e": "yarn workspaces foreach -A --include '@photo-contest/*' run test:e2e",
    "check": "yarn lint && yarn typecheck && yarn test"
  },
  "devDependencies": {
    "@side/eslint-config": "workspace:*",
    "@side/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.0",
    "jiti": "^2.6.1",
    "tsx": "^4.20.0",
    "typescript": "6.0.2"
  }
}
