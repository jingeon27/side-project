    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-presigned-post": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@types/node": "^24.0.0",
    "vitest": "^4.1.0"
