{
  "name": "@photo-contest/test-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "photo-contest-test-api": "./bin/serve-test-api.mjs"
  },
