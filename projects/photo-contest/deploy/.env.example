# /opt/photo-contest/.env 에 복사하고 chmod 600. 소셜·개발 로그인은 사용하지 않는다.
DOMAIN=contest.bambyul.com
WEB_ORIGIN=https://contest.bambyul.com
ACME_EMAIL=contact@bambyul.com
# openssl rand -hex 32 결과. URL에 넣으므로 영문·숫자만 사용한다.
POSTGRES_PASSWORD=replace_with_64_hex_characters

# 사진·동영상은 비공개 S3 호환 버킷(AWS S3·R2·MinIO)에만 둔다. 서버에는 미디어 volume이 없다.
# 버킷 CORS에 WEB_ORIGIN의 POST를 허용한다(shared-instance/s3-cors.json 참고). 조회는 서명 GET 이동이라 CORS가 필요 없다.
S3_BUCKET=
# AWS S3는 비워 둔다. R2·MinIO는 https:// endpoint를 지정한다(브라우저가 직접 접속한다).
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
# 선택: 버킷 안의 객체 경로. 예) photo-contest
S3_KEY_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# 앱 소셜 로그인 콜백(App Link·Universal Link) 검증 파일 값. 하나라도 없으면 웹이 시작하지 않는다.
# Apple Developer의 Team ID(10자)와 iOS bundle id, Android package
# Play Console > 앱 무결성 > 앱 서명 키 인증서 SHA-256(직접 서명해 배포하는 업로드 키가 있으면 쉼표로 함께)

PUSH_NOTIFICATIONS_ENABLED=false
EXPO_ACCESS_TOKEN=
