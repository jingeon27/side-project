# GitHub Environment photo-contest-production > SERVICE_ENV (whole file).
# /srv/side-project/services/photo-contest/.env, chmod 600. URL-encode passwords.
# shared-postgres is the host database on the internal db network; traffic never leaves the host, so TLS is off.
PC_DATABASE_URL=postgresql://photo_contest:REPLACE@shared-postgres:5432/photo_contest?schema=public&sslmode=disable&connection_limit=5&pool_timeout=10&connect_timeout=5
PC_DATABASE_MIGRATION_URL=postgresql://photo_contest_migrator:REPLACE@shared-postgres:5432/photo_contest?schema=public&sslmode=disable&connection_limit=2&pool_timeout=10&connect_timeout=5
PC_AWS_ACCESS_KEY_ID=
PC_AWS_SECRET_ACCESS_KEY=
PC_AWS_SESSION_TOKEN=
# Folder of the shared private bucket for newly uploaded objects; the IAM user only reaches photo-contest/production/.
PC_S3_KEY_PREFIX=photo-contest/production
PC_SENTRY_DSN=

# Native push: enable only after app EAS project and FCM/APNs credentials are configured.
PC_PUSH_NOTIFICATIONS_ENABLED=false
# Server only; enable enhanced push security in the Expo dashboard before setting this token.
PC_EXPO_ACCESS_TOKEN=

PC_S3_BUCKET=
PC_S3_REGION=ap-northeast-2
