# /srv/side-project/services/photo-contest/.env, chmod 600. URL-encode passwords.
DATABASE_URL=postgresql://photo_contest:REPLACE@RDS_ENDPOINT:5432/photo_contest?schema=public&sslmode=require&sslaccept=strict&sslcert=/run/rds/ca.pem&connection_limit=5&pool_timeout=10&connect_timeout=5
DATABASE_MIGRATION_URL=postgresql://photo_contest_migrator:REPLACE@RDS_ENDPOINT:5432/photo_contest?schema=public&sslmode=require&sslaccept=strict&sslcert=/run/rds/ca.pem&connection_limit=2&pool_timeout=10&connect_timeout=5
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional prefix for newly uploaded objects. Existing database keys remain readable.
S3_KEY_PREFIX=
SENTRY_DSN=

# Native push: enable only after app EAS project and FCM/APNs credentials are configured.
PUSH_NOTIFICATIONS_ENABLED=false
# Server only; enable enhanced push security in the Expo dashboard before setting this token.
EXPO_ACCESS_TOKEN=

S3_BUCKET=
S3_REGION=ap-northeast-2
