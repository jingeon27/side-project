{
  "name": "@photo-contest/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "yarn build && concurrently -k 'tsc -w' 'node --watch --env-file-if-exists=../../.env dist/main.js'",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:integration": "yarn build && vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/client": "6.19.0",
    "@sentry/node": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@side/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "prisma": "6.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "exports": {
    "./database-client": "./generated/prisma/index.js"
  }
}
