{
  "name": "@photo-contest/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "sentry:check": "node --env-file-if-exists=../../.env --import tsx scripts/check-sentry.ts",
    "dev": "yarn build && concurrently -k 'tsc7 -w -p tsconfig.build.json' 'node --watch --env-file-if-exists=../../.env dist/main.js'",
    "build": "yarn workspace @side/toolkit build && tsc7 -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "yarn workspace @side/toolkit build && tsc7 --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "yarn workspace @side/toolkit build && vitest run --project unit",
    "test:unit": "yarn workspace @side/toolkit build && vitest run --project unit",
    "test:e2e": "yarn test:integration",
    "test:integration": "yarn workspace @side/toolkit build && vitest run --project integration",
    "test:database": "yarn workspace @side/toolkit build && vitest run --project database"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.0",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-presigned-post": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@sentry/node": "catalog:",
    "@side/toolkit": "workspace:*",
    "dayjs": "catalog:",
    "es-toolkit": "catalog:",
    "express": "catalog:",
    "graphql": "catalog:",
    "graphql-depth-limit": "^1.1.0",
    "prisma": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@photo-contest/test-kit": "workspace:*",
    "@side/config": "workspace:*",
    "@swc/core": "^1.16.0",
    "@types/express": "catalog:",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "concurrently": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "catalog:"
  },
  "exports": {
    "./database-adapter": "./src/database/prisma-adapter.ts",
    "./prisma.config.ts": "./prisma.config.ts",
    "./database-client": "./generated/prisma/index.js",
    "./prisma/schema.prisma": "./prisma/schema.prisma",
    "./package.json": "./package.json"
  }
}
