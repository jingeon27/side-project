generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  nickname String
  avatar String?
  provider String
  providerId String
  memberships GroupMember[]
  groupJoinRequests GroupJoinRequest[]
  credential PasswordCredential?
  sessions Session[]
  submissions Submission[]
  votes Vote[]
  uploads Upload[]
  reports Report[]
  likes Like[]
  appLoginTickets AppLoginTicket[]
  posts Post[]
  postUploads PostUpload[]
  postLikes PostLike[]
  postComments PostComment[]
  postCommentLikes PostCommentLike[]
  postContestVotes PostContestVote[]
  createdAt DateTime @default(now())
  @@unique([provider, providerId])
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model OAuthAttempt {
  stateHash String @id
  provider String
  verifier String
  appChallenge String?
  expiresAt DateTime
}
model Group {
  categories GroupCategory[]
  id String @id @default(cuid())
  name String
  visibility String @default("PRIVATE")
  inviteHash String @unique
  inviteToken String
  createdAt DateTime @default(now())
  members GroupMember[]
  joinRequests GroupJoinRequest[]
  contests Contest[]
  posts Post[]
  postUploads PostUpload[]
  @@index([createdAt, id])
}
model GroupJoinRequest {
  id String @id @default(cuid())
  groupId String
  userId String
  createdAt DateTime @default(now())
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([groupId, createdAt, id])
}
model GroupMember {
  groupId String
  userId String
  role String @default("MEMBER")
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  @@id([groupId, userId])
  @@index([userId])
}
model Contest {
  format String @default("LEGACY")
  completionTrackedAt DateTime?
  id String @id @default(cuid())
  groupId String
  title String
  startsAt DateTime
  submissionEndsAt DateTime
  endsAt DateTime
  createdAt DateTime @default(now())
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submissions Submission[]
  votes Vote[]
  uploads Upload[]
  posts Post[]
  postVotes PostContestVote[]
  @@index([groupId, format, endsAt, id])
  @@index([groupId, createdAt])
}
model Upload {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  contestId String
  expiresAt DateTime
  imageKey String? @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submission Submission?
}
model Submission {
  id String @id @default(cuid())
  contestId String
  authorId String
  caption String
  uploadId String @unique
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id])
  galleryPost Post?
  votes Vote[]
  reports Report[]
  likes Like[]
  @@unique([contestId, authorId])
  @@index([contestId, createdAt])
}
model Vote {
  id String @id @default(cuid())
  contestId String
  submissionId String
  voterId String
  createdAt DateTime @default(now())
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voter User @relation(fields: [voterId], references: [id], onDelete: Cascade)
  @@unique([contestId, voterId])
  @@index([submissionId])
}
model Report {
  id String @id @default(cuid())
  submissionId String
  reporterId String
  reason String
  createdAt DateTime @default(now())
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  @@unique([submissionId, reporterId])
}
model Like {
  submissionId String
  userId String
  createdAt DateTime @default(now())
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([submissionId, userId])
  @@index([userId])
}
model AppLoginTicket {
  codeHash String @id
  userId String
  challenge String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model AnalyticsEvent {
  id String @id
  type String
  userId String?
  properties Json
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  @@index([deliveredAt, createdAt])
}

model PostUpload {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  groupId String
  expiresAt DateTime
  storageKey String? @unique
  kind String @default("PHOTO")
  contentType String @default("image/webp")
  byteSize Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  post Post?
  @@index([expiresAt])
}
model Post {
  categoryId String?
  category GroupCategory? @relation(fields: [categoryId, groupId], references: [id, groupId], onUpdate: NoAction, onDelete: Restrict)
  @@index([groupId, categoryId, createdAt])
  contestId String?
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)
  id String @id @default(cuid())
  groupId String
  authorId String
  uploadId String? @unique
  linkUrl String?
  title String
  body String @default("")
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  legacySubmissionId String? @unique
  legacySubmission Submission? @relation(fields: [legacySubmissionId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  upload PostUpload? @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  likes PostLike[]
  comments PostComment[]
  contestVotes PostContestVote[]
  @@unique([id, contestId])
  @@index([contestId, createdAt, id])
  @@index([groupId, createdAt, id])
}
model PostComment {
  id String @id @default(cuid())
  postId String
  authorId String
  body String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes PostCommentLike[]
  @@index([postId, createdAt, id])
}
model PostCommentLike {
  commentId String
  userId String
  createdAt DateTime @default(now())
  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([commentId, userId])
  @@index([userId])
}
model PostLike {
  postId String
  userId String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
  @@index([userId])
}
model PasswordCredential {
  loginId String @id
  passwordHash String
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model AuthAttempt {
  keyHash String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model PostContestVote {
  id String @id @default(cuid())
  contestId String
  postId String
  voterId String
  createdAt DateTime @default(now())
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId, contestId], references: [id, contestId], onDelete: Cascade)
  voter User @relation(fields: [voterId], references: [id], onDelete: Cascade)
  @@unique([contestId, voterId])
  @@index([postId])
}

model GroupCategory {
  id String @id @default(cuid())
  groupId String
  name String
  position Int
  archivedAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
  posts Post[]
  @@unique([id,groupId])
  @@index([groupId,archivedAt,position])
}
