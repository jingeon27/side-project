generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(cuid())
  nickname String
  needsOnboarding Boolean @default(false)
  termsAcceptedAt DateTime?
  termsVersion String?
  avatar String?
  avatarUploadId String? @unique
  avatarUpload ProfileUpload? @relation("CurrentUserAvatar", fields: [avatarUploadId], references: [id], onDelete: SetNull)
  profileUploads ProfileUpload[] @relation("UserProfileUploads")
  provider String
  providerId String
  memberships GroupMember[]
  groupJoinRequests GroupJoinRequest[]
  credential PasswordCredential?
  pushDevices PushDevice[]
  sessions Session[]
  submissions Submission[]
  votes Vote[]
  uploads Upload[]
  reports Report[]
  likes Like[]
  appLoginTickets AppLoginTicket[]
  posts Post[]
  postUploads PostUpload[]
  postLikes PostLike[]
  postComments PostComment[]
  postCommentLikes PostCommentLike[]
  postContestVotes PostContestVote[]
  notifications Notification[] @relation("NotificationRecipient")
  notificationActions Notification[] @relation("NotificationActor")
  createdAt DateTime @default(now())
  @@unique([provider, providerId])
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
  pushDevices PushDevice[]
}
model OAuthAttempt {
  stateHash String @id
  provider String
  verifier String
  appChallenge String?
  expiresAt DateTime
}
model Group {
  categories GroupCategory[]
  id String @id @default(cuid())
  name String
  description String @default("")
  avatarId String?
  avatar GroupAvatar? @relation("CurrentGroupAvatar", fields: [avatarId, id], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)
  coverId String?
  cover GroupAvatar? @relation("CurrentGroupCover", fields: [coverId, id], references: [id, groupId], onDelete: NoAction, onUpdate: NoAction)
  avatarUploads GroupAvatar[] @relation("GroupAvatarUploads")
  visibility String @default("PRIVATE")
  inviteHash String @unique
  inviteToken String
  createdAt DateTime @default(now())
  members GroupMember[]
  joinRequests GroupJoinRequest[]
  contests Contest[]
  posts Post[]
  postUploads PostUpload[]
  notifications Notification[]
  @@index([createdAt, id])
}
model GroupAvatar {
  mediaUploadId String? @unique
  mediaUpload PostUpload? @relation(fields: [mediaUploadId], references: [id], onDelete: SetNull)
  id String @id @default(cuid())
  groupId String
  storageKey String @unique
  expiresAt DateTime
  group Group @relation("GroupAvatarUploads", fields: [groupId], references: [id], onDelete: Cascade)
  currentGroups Group[] @relation("CurrentGroupAvatar")
  coverGroups Group[] @relation("CurrentGroupCover")
  @@unique([id, groupId])
  @@index([expiresAt])
}
model GroupJoinRequest {
  id String @id @default(cuid())
  groupId String
  userId String
  createdAt DateTime @default(now())
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
  @@unique([groupId, userId])
  @@index([groupId, createdAt, id])
}
model GroupMember {
  groupId String
  userId String
  role String @default("MEMBER")
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  @@id([groupId, userId])
  @@index([userId])
}
model Contest {
  format String @default("LEGACY")
  completionTrackedAt DateTime?
  startNotifiedAt DateTime?
  endNotifiedAt DateTime?
  id String @id @default(cuid())
  groupId String
  title String
  likeLimit Int @default(1)
  startsAt DateTime
  submissionEndsAt DateTime
  endsAt DateTime
  createdAt DateTime @default(now())
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submissions Submission[]
  votes Vote[]
  uploads Upload[]
  posts Post[]
  postVotes PostContestVote[]
  notifications Notification[]
  @@index([groupId, format, endsAt, id])
  @@index([groupId, createdAt])
}
model Upload {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  contestId String
  expiresAt DateTime
  imageKey String? @unique
  mediaUploadId String? @unique
  mediaUpload PostUpload? @relation(fields: [mediaUploadId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submission Submission?
}
model Submission {
  id String @id @default(cuid())
  contestId String
  authorId String
  caption String
  uploadId String @unique
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id])
  galleryPost Post?
  votes Vote[]
  reports Report[]
  likes Like[]
  @@unique([contestId, authorId])
  @@index([contestId, createdAt])
}
model Vote {
  id String @id @default(cuid())
  contestId String
  submissionId String
  voterId String
  createdAt DateTime @default(now())
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voter User @relation(fields: [voterId], references: [id], onDelete: Cascade)
  @@unique([contestId, voterId])
  @@index([submissionId])
}
model Report {
  id String @id @default(cuid())
  submissionId String
  reporterId String
  reason String
  createdAt DateTime @default(now())
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  @@unique([submissionId, reporterId])
}
model Like {
  submissionId String
  userId String
  createdAt DateTime @default(now())
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([submissionId, userId])
  @@index([userId])
}
model AppLoginTicket {
  codeHash String @id
  userId String
  challenge String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model AnalyticsEvent {
  id String @id
  type String
  userId String?
  properties Json
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  @@index([deliveredAt, createdAt])
}

model PostUpload {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  groupId String
  expiresAt DateTime
  policyExpiresAt DateTime?
  storageKey String? @unique
  stagingKey String? @unique
  completionKey String? @unique
  completionStartedAt DateTime?
  attempts PostUploadAttempt[]
  kind String @default("PHOTO")
  contentType String @default("image/webp")
  byteSize Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  post Post?
  submissionUpload Upload?
  groupAvatar GroupAvatar?
  @@index([expiresAt])
  @@index([userId])
}
model PostUploadAttempt {
  key String @id
  uploadId String?
  createdAt DateTime @default(now())
  upload PostUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([uploadId])
}
model Post {
  categoryId String?
  category GroupCategory? @relation(fields: [categoryId, groupId], references: [id, groupId], onUpdate: NoAction, onDelete: Restrict)
  @@index([groupId, categoryId, createdAt])
  contestId String?
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)
  id String @id @default(cuid())
  groupId String
  authorId String
  uploadId String? @unique
  linkUrl String?
  title String
  body String @default("")
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  legacySubmissionId String? @unique
  legacySubmission Submission? @relation(fields: [legacySubmissionId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  upload PostUpload? @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  likes PostLike[]
  comments PostComment[]
  contestVotes PostContestVote[]
  notifications Notification[]
  @@unique([id, contestId])
  @@index([contestId, createdAt, id])
  @@index([groupId, createdAt, id])
  @@index([authorId, createdAt, id])
}
model PostComment {
  id String @id @default(cuid())
  postId String
  authorId String
  parentId String?
  body String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes PostCommentLike[]
  parent PostComment? @relation("PostCommentReplies", fields: [parentId, postId], references: [id, postId], onDelete: Cascade)
  replies PostComment[] @relation("PostCommentReplies")
  notifications Notification[]
  @@unique([id, postId])
  @@index([postId, createdAt, id])
  @@index([postId, parentId, createdAt, id])
}
model PostCommentLike {
  commentId String
  userId String
  createdAt DateTime @default(now())
  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([commentId, userId])
  @@index([userId])
}
model PostLike {
  postId String
  userId String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
  @@index([userId])
}
model PasswordCredential {
  loginId String @id
  passwordHash String
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model AuthAttempt {
  keyHash String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model RateLimitBucket {
  keyHash String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model PostContestVote {
  id String @id @default(cuid())
  contestId String
  postId String
  voterId String
  createdAt DateTime @default(now())
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId, contestId], references: [id, contestId], onDelete: Cascade)
  voter User @relation(fields: [voterId], references: [id], onDelete: Cascade)
  @@unique([contestId, voterId])
  @@index([postId])
}

model GroupCategory {
  id String @id @default(cuid())
  groupId String
  name String
  position Int
  archivedAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
  posts Post[]
  @@unique([id,groupId])
  @@index([groupId,archivedAt,position])
}
model ProfileUpload {
  id String @id @default(cuid())
  userId String
  user User @relation("UserProfileUploads", fields: [userId], references: [id], onDelete: Cascade)
  currentUsers User[] @relation("CurrentUserAvatar")
  storageKey String @unique
  contentType String
  byteSize Int
  completedAt DateTime?
  expiresAt DateTime
  policyExpiresAt DateTime
  @@index([userId, expiresAt])
  @@index([expiresAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  actorId String?
  groupId String
  postId String?
  commentId String?
  contestId String?
  joinRequestId String?
  type String
  eventKey String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: Cascade)
  joinRequest GroupJoinRequest? @relation(fields: [joinRequestId], references: [id], onDelete: Cascade)
  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt, id])
  @@index([groupId])
  @@index([postId])
  @@index([commentId])
  @@index([contestId])
  @@index([joinRequestId])
}

model PushDevice {
  id String @id
  token String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey String
  session Session @relation(fields: [sessionKey], references: [tokenHash], onDelete: Cascade)
  platform String
  locale String @default("ko")
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries PushDelivery[]
  @@index([userId, enabled])
  @@index([sessionKey])
}
// 두 알림 테이블을 쓰는 서비스도 같은 큐를 쓰므로 eventId는 전송 직전에 도메인에서 다시 검증한다.
model PushDelivery {
  id String @id @default(cuid())
  deviceId String
  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventId String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  ticketId String?
  createdAt DateTime @default(now())
  @@unique([deviceId, eventId])
  @@index([status, nextAttemptAt, leaseUntil])
  @@index([createdAt])
}
