    "test": "node scripts/test.ts --project unit --project ui",
    "test:unit": "node scripts/test.ts --project unit",
    "test:api": "node scripts/test.ts --project api",
    "test:e2e": "playwright test",
    "bundle:check": "node scripts/bundle-check.ts"
