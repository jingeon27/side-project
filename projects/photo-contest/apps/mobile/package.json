    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "jsdom": "^29.0.0",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
