# Configure these values in the release build environment (EAS environment variables).
EXPO_PUBLIC_WEB_ORIGIN=https://contest.bambyul.com
# 소셜 로그인 콜백 앱 링크 값. 하나라도 없으면 운영 빌드(APP_VARIANT가 development가 아닌 빌드)가 멈춘다.
# 웹 서버의 같은 이름 값과 같아야 한다.
MOBILE_APPLE_TEAM_ID=
MOBILE_IOS_BUNDLE_ID=
MOBILE_ANDROID_PACKAGE=
