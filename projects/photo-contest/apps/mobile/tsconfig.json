{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": [
    "node_modules",
    ".expo",
    ".expo-export-check",
    "android",
    "ios",
    "playwright-report",
    "test-results"
  ]
}
