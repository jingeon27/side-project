{
  "name": "@photo-contest/web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "node ../../../../scripts/run-next.ts dev -p 3200",
    "build": "node ../../../../scripts/run-next.ts build",
    "start": "node ../../../../scripts/run-next.ts start -p 3200",
    "typecheck": "tsc7 --noEmit",
    "lint": "eslint .",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "node scripts/test.ts --project unit --project ui",
    "test:unit": "node scripts/test.ts --project unit",
    "test:api": "node scripts/test.ts --project api",
    "test:e2e": "playwright test",
    "test:deploy": "playwright test --config playwright.deploy.config.ts",
    "test:cache": "playwright test --config playwright.cache.config.ts",
    "test:observability": "playwright test --config playwright.observability.config.ts",
    "monitoring:check": "playwright test --config playwright.monitoring.config.ts"
  },
