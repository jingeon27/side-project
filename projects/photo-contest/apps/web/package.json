    "eslint": "^9.39.0",
    "graphql": "^16.11.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.0"
  }
