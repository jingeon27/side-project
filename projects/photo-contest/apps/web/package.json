    "@graphql-typed-document-node/core": "^3.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@photo-contest/bridge": "workspace:*",
    "@sentry/nextjs": "^11.7.0",
    "@side/design-system": "workspace:*",
    "es-toolkit": "^1.52.0",
    "graphql": "^16.11.0",
    "lucide-react": "^1.23.0",
    "next": "16.4.2",
    "overlay-kit": "^1.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.81.0",
    "rxjs": "^7.8.2",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@apollo/client-react-streaming": "patch:@apollo/client-react-streaming@npm%3A0.14.5#~/.yarn/patches/@apollo-client-react-streaming-npm-0.14.5-7738a89319.patch",
