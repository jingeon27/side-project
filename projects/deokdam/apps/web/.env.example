# Optional live AI. The API receives the choices, an element, and an optional experience theme.
DEOKDAM_AI_API_KEY=
DEOKDAM_AI_MODEL=
DEOKDAM_AI_LOCAL_PORT=

# Optional absolute SQLite path for the bundled reading knowledge. Use a different file from orders.
DEOKDAM_READING_DB=

# Public playlist override for the story section. An empty value hides the player.
DEOKDAM_SHORTS_PLAYLIST_ID=PLdR732KbVakE

# Optional Google Ad Manager rewarded unit configured for video demand.
DEOKDAM_REWARDED_AD_UNIT=

# PortOne test or approved live merchant. Unset fields keep checkout disabled.
DEOKDAM_PORTONE_STORE_ID=
DEOKDAM_PORTONE_CHANNEL_KEY=
DEOKDAM_PORTONE_API_SECRET=
DEOKDAM_ORDER_DB=
DEOKDAM_SUPPORT_EMAIL=
DEOKDAM_PUBLIC_ORIGIN=

# Optional Deokdam-only Amplitude project.
NEXT_PUBLIC_DEOKDAM_AMPLITUDE_KEY=
