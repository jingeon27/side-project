# Public canonical origin. Production: https://blog.bambyul.com (Vercel).
SITE_URL=http://localhost:3100
# Optional GA4 web stream ID. Collected for every visitor until they turn it off on the privacy page (opt-out).
# Production builds use the default ID when this is unset; an empty value disables collection.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Clarity is disabled: its hosted collector cannot guarantee search-term removal from URLs.
GOOGLE_SITE_VERIFICATION=
# Optional monitoring. Keep auth tokens in deployment secrets.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
