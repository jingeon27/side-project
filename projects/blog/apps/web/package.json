{
  "name": "@blog/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "yarn content:generate && next dev --port 3100",
    "start": "next start --port 3100",
    "build": "yarn content:generate && next build",
    "content:generate": "tsx scripts/generate-article-registry.ts",
    "content:validate": "tsx scripts/generate-article-registry.ts --check",
    "typecheck": "yarn content:generate && tsc7 --noEmit",
    "lint": "eslint .",
    "test": "yarn content:generate && vitest run",
    "test:e2e": "playwright test",
    "check": "yarn content:validate && yarn typecheck && yarn lint && yarn test"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.3",
    "@sentry/nextjs": "^11.7.0",
    "cmdk": "^1.1.1",
    "github-slugger": "^2.0.0",
    "image-size": "^2.0.2",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "1.64.0",
    "@side/config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "6.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
