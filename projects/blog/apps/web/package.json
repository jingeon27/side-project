{
  "name": "@blog/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "yarn content:generate && next dev --port 3100",
    "start": "next start --port 3100",
    "build": "yarn content:generate && next build",
    "content:generate": "tsx scripts/generate-article-registry.ts",
    "content:validate": "tsx scripts/generate-article-registry.ts --check",
    "typecheck": "yarn content:generate && tsc7 --noEmit",
    "lint": "eslint .",
    "test": "yarn content:generate && vitest run",
    "test:e2e": "playwright test",
    "check": "yarn content:validate && yarn typecheck && yarn lint && yarn test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "catalog:",
    "@sentry/nextjs": "catalog:",
    "dayjs": "catalog:",
    "es-toolkit": "catalog:",
    "github-slugger": "^2.0.0",
    "image-size": "^2.0.2",
    "next": "catalog:",
    "next-intl": "^4.14.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "catalog:",
    "@side/config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "catalog:",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
