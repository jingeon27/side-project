{
  "name": "@clash-bot/agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "trophy": "node src/trophy/cli.ts",
    "doctor": "node src/cli.ts doctor",
    "connect": "node src/cli.ts connect",
    "setup": "node src/cli.ts setup",
    "capture": "node src/cli.ts capture",
    "observe": "node src/cli.ts observe",
    "play": "node src/cli.ts play",
    "analyze": "node src/cli.ts analyze",
    "learn": "node src/cli.ts learn",
    "calibrate": "node src/cli.ts calibrate",
    "help": "node src/cli.ts --help",
    "emulator": "node src/cli.ts emulator",
    "typecheck": "tsc7 --noEmit",
    "test": "vitest run",
    "qwen": "node src/qwen-cli.ts",
    "qwen:setup": "python3.11 src/qwen/setup.py",
    "selfplay": "node src/selfplay-cli.ts",
    "opponent": "node src/opponent-cli.ts",
    "counterpush": "node src/counterpush/cli.ts",
    "counterpush:setup": "python3.11 src/counterpush/perception/setup.py",
    "test:perception": "../../.data/qwen/.venv/bin/python -m unittest discover -s src/counterpush/perception -p '*_test.py'",
    "test:perception:model": "RUN_COUNTERPUSH_INTEGRATION=1 ../../.data/qwen/.venv/bin/python -m unittest discover -s src/counterpush/perception -p 'vision_model_test.py'",
    "test:learning": "../../.data/qwen/.venv/bin/python -m unittest discover -s src/qwen -p '*_test.py'",
    "test:learning:model": "RUN_QWEN_INTEGRATION=1 ../../.data/qwen/.venv/bin/python -m unittest discover -s src/qwen -p 'learning_model_test.py'",
    "arena": "node src/arena-cli.ts",
    "arena:setup": "python3.11 src/arena/setup.py",
    "test:arena": "PYTHONPATH=src OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 ../../.data/qwen/.venv/bin/python -m unittest discover -s src/arena -t src -p \"*_test.py\""
  },
  "dependencies": {
    "playwright": "1.64.0",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@side/config": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
