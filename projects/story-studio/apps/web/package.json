{
  "name": "@story-studio/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3400",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3400",
    "typecheck": "tsc7 --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "yarn typecheck && yarn test",
    "local:setup": "node --env-file-if-exists=.env.local scripts/setup-local.ts",
    "local:setup:image": "node --env-file-if-exists=.env.local scripts/setup-local.ts --image",
    "local:setup:voice": "node --env-file-if-exists=.env.local scripts/setup-local.ts --voice-training"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@side/design-system": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "dayjs": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@side/config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
