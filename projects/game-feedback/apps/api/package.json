{
  "name": "@game-feedback/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --require tsx/cjs src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc7 -p tsconfig.json && tsc7 -p tsconfig.build.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --project unit",
    "test:integration": "node scripts/test.mjs --project integration",
    "test:server": "tsx src/testing/e2e-server.ts",
    "prisma:generate": "prisma generate",
    "db:seed": "tsx src/seed.ts",
    "check": "yarn typecheck",
    "db:generate": "prisma generate",
    "openapi": "tsx src/openapi.ts",
    "db:sync": "node ../../scripts/db.mjs sync",
    "prisma:sync": "prisma db push --skip-generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/lib-storage": "3.1149.0",
    "@aws-sdk/s3-presigned-post": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@game-feedback/contracts": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "6.19.0",
    "@sentry/node": "^10.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "es-toolkit": "^1.52.0",
    "express": "^5.1.0",
    "prisma": "6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "ts-pattern": "^5.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@side/typescript-config": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "6.0.2",
    "vitest": "^4.0.0"
  }
}
