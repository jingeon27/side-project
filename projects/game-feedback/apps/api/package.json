{
  "name": "@game-feedback/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sentry:check": "node --env-file-if-exists=../../.env --import tsx scripts/check-sentry.ts",
    "dev": "yarn workspace @side/toolkit build && node --watch --require tsx/cjs src/main.ts",
    "build": "yarn workspace @side/toolkit build && node scripts/build.ts",
    "start": "node dist/main.js",
    "typecheck": "yarn workspace @side/toolkit build && tsc7 -p tsconfig.json && tsc7 -p tsconfig.build.json --noEmit",
    "test": "node scripts/test.ts",
    "test:unit": "node scripts/test.ts --project unit",
    "test:integration": "node scripts/test.ts --project integration",
    "test:server": "yarn workspace @side/toolkit build && tsx src/testing/e2e-server.ts",
    "prisma:generate": "prisma generate",
    "db:seed": "tsx src/seed.ts",
    "check": "yarn typecheck",
    "db:generate": "prisma generate",
    "openapi": "yarn workspace @side/toolkit build && tsx src/openapi.ts",
    "db:sync": "node ../../scripts/db.ts sync",
    "prisma:sync": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-presigned-post": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@game-feedback/contracts": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@sentry/node": "catalog:",
    "@side/toolkit": "workspace:*",
    "es-toolkit": "catalog:",
    "express": "catalog:",
    "prisma": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@side/config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
