{
  "extends": "@side/typescript-config/base",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "*.mts"],
  "exclude": ["src/generated"]
}
