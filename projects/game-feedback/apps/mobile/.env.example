# Development client only. Release builds require an explicit HTTPS origin.
APP_VARIANT=development
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3300

# Public EAS project UUID for this app (not the other service). Rebuild the dev client after changing native plugins.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android Firebase app configuration file path (EAS file environment variable), not the FCM service-account private key.
MOBILE_GOOGLE_SERVICES_JSON=
