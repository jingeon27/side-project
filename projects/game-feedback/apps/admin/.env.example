# Local-only proxy to an SSH tunnel. These variables are never sent to the browser.
# ssh -N -L 14300:127.0.0.1:4300 deploy@LIGHTSAIL_IP
GF_ADMIN_API_ORIGIN=http://127.0.0.1:14300
GF_ADMIN_WEB_ORIGIN=https://your-domain.example
# Capture the one-hour operator CLI credential here; never commit this file after copying to .env.local.
GF_ADMIN_ACCESS_TOKEN=
