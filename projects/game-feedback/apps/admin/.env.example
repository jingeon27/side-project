# Local-only Vite proxy settings. These variables are never sent to the browser.
# Local development needs no file: the proxy defaults to the dev API (http://localhost:4300)
# and the dev web origin (http://localhost:3300).
#GF_ADMIN_PORT=3303
#GF_ADMIN_API_ORIGIN=http://localhost:4300
#GF_ADMIN_WEB_ORIGIN=http://localhost:3300

# Operator mode: do not put the operator token in .env.local or any env file.
# Every later `dev` run (including E2E) would read it and fail to start with an http origin.
# Pass the values as shell variables for a single run, as in deploy/shared-instance/README.md (운영 명령):
#   ssh -N -L 14300:127.0.0.1:4300 ubuntu@<IP>
#   GF_ADMIN_API_ORIGIN=http://127.0.0.1:14300 \
#   GF_ADMIN_WEB_ORIGIN=https://<domain> \
#   GF_ADMIN_ACCESS_TOKEN="$(ssh ubuntu@<IP> 'bash /srv/side-project/services/game-feedback/current/host/service.sh game-feedback operator session <user-id>')" \
#   corepack yarn workspace @side/game-feedback admin:dev
