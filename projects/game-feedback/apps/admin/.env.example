# Server-side proxy settings. Default: production API over a local SSH tunnel.
# No credentials belong in VITE_* variables or env files.
GF_ADMIN_PORT=3303
GF_ADMIN_API_ORIGIN=http://127.0.0.1:14300
GF_ADMIN_WEB_ORIGIN=https://game.bambyul.com

# Start the tunnel before opening Admin:
# ssh -N -L 14300:127.0.0.1:4300 ubuntu@<IP>
# Tests/local API may explicitly override the two origins; the ID/password login is identical.
