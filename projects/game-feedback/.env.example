# Local settings only. Copy to .env; never commit credentials.
NODE_ENV=development
PORT=4300
WEB_ORIGIN=http://localhost:3300
API_ORIGIN=http://localhost:4300
GAME_FEEDBACK_API_URL=http://127.0.0.1:4300
# The project dev runner generates a shared ephemeral secret when these are blank.
# For independently started Web/API processes, set the same random server-only secret (32+ characters).
GF_CACHE_REVALIDATION_SECRET=
GF_CACHE_REVALIDATION_URL=http://localhost:3300/internal/cache/revalidate
DATABASE_URL=postgresql://game_feedback:game_feedback_local@127.0.0.1:55442/game_feedback?schema=public
TEST_DATABASE_URL=postgresql://game_feedback:game_feedback_local@127.0.0.1:55444/game_feedback_test?schema=public

# Demo authentication and fake game data require the explicit dev:demo command.
GF_DEMO_MODE=false
GF_TEST_AUTH_ENABLED=false
# dev:test enables only local test account tokens and sample content, without demo UI.

# OAuth requests only the openid scope. Service nickname is entered separately.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3300/api/auth/google/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3300/api/auth/social/x/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3300/api/auth/social/kakao/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3300/api/auth/social/discord/callback
# Mobile app login codes go only to this verified HTTPS App Link / Universal Link on WEB_ORIGIN.
# Development and tests default to WEB_ORIGIN/app-auth/callback; production refuses to start without it.
MOBILE_AUTH_CALLBACK_URL=

# Configure a key and registered outbound IP before using the real provider.
SUPERCELL_API_TOKEN=

# Set only in a trusted operator environment to bootstrap a service admin.
GF_ADMIN_GOOGLE_SUB=

# Set a real operator contact before inviting external alpha users.
# Public support address displayed on error and contact pages.
GAME_FEEDBACK_CONTACT_EMAIL=contact@bambyul.com

# Canonical public origin. Keep alpha, demo and preview deployments out of search.
GAME_FEEDBACK_SITE_URL=http://localhost:3300
GAME_FEEDBACK_INDEXING=false
# Public indexing requires production, HTTPS, indexing=true and demo=false.

# DATABASE keeps local attachments in PostgreSQL; S3 enables direct post/chat uploads.
# Private bucket CORS must allow the browser origin; see docs/media-upload.md.
GF_MEDIA_STORAGE=DATABASE
GF_S3_BUCKET=
GF_S3_REGION=ap-northeast-2
GF_S3_ENDPOINT=
GF_S3_FORCE_PATH_STYLE=false
# Server only. Never prefix AWS credentials with NEXT_PUBLIC_.
GF_S3_ACCESS_KEY_ID=
GF_S3_SECRET_ACCESS_KEY=

# Optional telemetry; blank keys disable collection. Use development projects locally.
# The project dev/dev:test commands load this file for Web and API together.
# Public keys are embedded in the browser bundle; restart after changing them.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# This local runner shares SENTRY_DSN between API and Next server errors.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# SENTRY_AUTH_TOKEN is for CI source-map upload, not local error collection.
