# Local settings only. Copy to .env; never commit credentials.
ENVIRONMENT=development
WEB_ORIGIN=http://localhost:3300
GAME_FEEDBACK_API_URL=http://127.0.0.1:4300
DATABASE_URL=postgresql://game_feedback:game_feedback_local@127.0.0.1:55442/game_feedback?schema=public
# The dev runner sets ports, cache credentials and the isolated test database automatically.

# OAuth requests only the openid scope. Service nickname is entered separately.
# Redirect URIs are derived from WEB_ORIGIN. Register the matching callback at each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Configure a key and registered outbound IP before using the real provider.
SUPERCELL_API_TOKEN=

# Set a real operator contact before inviting external alpha users.
# Public support address displayed on error and contact pages.
GAME_FEEDBACK_CONTACT_EMAIL=contact@bambyul.com

# The local canonical origin uses WEB_ORIGIN. Production sets its public origin in deployment settings.

# All files (including avatars) use S3 presigned uploads.
# Local development and integration tests use the configured AWS S3 bucket; no local storage server is started.
# Private bucket CORS must allow the browser origin; see docs/media-upload.md.
GF_S3_BUCKET=
GF_S3_REGION=ap-northeast-2
GF_S3_KEY_PREFIX=
GF_S3_ENDPOINT=
GF_S3_FORCE_PATH_STYLE=false
# Server only. Never prefix AWS credentials with NEXT_PUBLIC_.
GF_S3_ACCESS_KEY_ID=
GF_S3_SECRET_ACCESS_KEY=
# Prefer a named AWS CLI profile for local AWS tests; custom GF_S3 keys can stay blank.
AWS_PROFILE=

# Optional telemetry; blank keys disable collection. Use development projects locally.
# The project dev/dev:test commands load this file for Web and API together.
# Public keys are embedded in the browser bundle; restart after changing them.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# This local runner shares SENTRY_DSN between API and Next server errors.
SENTRY_DSN=
# One release value is shared by API, Next server and the browser bundle.
SENTRY_RELEASE=
# Native mobile builds read the same root file; only public telemetry keys enter the app bundle.

# Native push: enable only after app EAS project and FCM/APNs credentials are configured.
PUSH_NOTIFICATIONS_ENABLED=false
# Server only; enable enhanced push security in the Expo dashboard before setting this token.
EXPO_ACCESS_TOKEN=
