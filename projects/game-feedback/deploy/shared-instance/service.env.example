# /srv/side-project/services/game-feedback/.env, chmod 600. URL-encode passwords.
DATABASE_URL=postgresql://game_feedback:REPLACE@RDS_ENDPOINT:5432/game_feedback?schema=public&sslmode=require&sslaccept=strict&sslcert=/run/rds/ca.pem&connection_limit=5&pool_timeout=10&connect_timeout=5
DATABASE_MIGRATION_URL=postgresql://game_feedback_migrator:REPLACE@RDS_ENDPOINT:5432/game_feedback?schema=public&sslmode=require&sslaccept=strict&sslcert=/run/rds/ca.pem&connection_limit=2&pool_timeout=10&connect_timeout=5
GF_S3_ACCESS_KEY_ID=
GF_S3_SECRET_ACCESS_KEY=
# Direct post/chat uploads also require bucket CORS: see docs/media-upload.md.
GAME_FEEDBACK_CONTACT_EMAIL=contact@bambyul.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SUPERCELL_API_TOKEN=


# API errors only; public web keys are GitHub Variables at build time.
SENTRY_DSN=
ENVIRONMENT=production

# Native push: enable only after app EAS project and FCM/APNs credentials are configured.
PUSH_NOTIFICATIONS_ENABLED=false
# Server only; enable enhanced push security in the Expo dashboard before setting this token.
EXPO_ACCESS_TOKEN=

GF_S3_BUCKET=
GF_S3_REGION=ap-northeast-2
GF_S3_KEY_PREFIX=game-feedback
