# Copy to /srv/game-feedback/.env (chmod 600). Compose reads this file; never source it in a shell.
GF_DOMAIN=game.bambyul.com
GF_CONTACT_EMAIL=contact@bambyul.com
GF_IMAGE_PREFIX=ghcr.io/jingeon27/side-project-game-feedback
# Generate two independent values with: openssl rand -hex 32
GF_DB_PASSWORD=replace-me
GF_DB_ADMIN_PASSWORD=replace-me
# Generate another independent value with: openssl rand -hex 32
GF_CACHE_REVALIDATION_SECRET=
GF_INDEXING=false

# Configure at least one complete pair. Redirect URIs use https://GF_DOMAIN and the current API callbacks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SUPERCELL_API_TOKEN=
# Optional Google subject bootstrap; an SSH operator can also grant an existing real account.
GF_ADMIN_GOOGLE_SUB=

# Mobile social login App Link / Universal Link files (required by web; empty values stop Compose).
# Apple Developer Team ID (10 characters), iOS bundle id and Android package.
MOBILE_APPLE_TEAM_ID=
MOBILE_IOS_BUNDLE_ID=
MOBILE_ANDROID_PACKAGE=
# Play Console > App integrity > App signing key certificate SHA-256 (AA:BB:...), comma-separated with an upload key if used.
MOBILE_ANDROID_SHA256_FINGERPRINTS=

# FILESYSTEM uses the included Lightsail disk and a persistent Docker volume.
# S3 accepts either AWS S3 or Cloudflare R2; objects remain private and API-authorized.
GF_MEDIA_STORAGE=FILESYSTEM
GF_S3_BUCKET=
GF_S3_REGION=auto
GF_S3_ENDPOINT=
GF_S3_ACCESS_KEY_ID=
GF_S3_SECRET_ACCESS_KEY=

# Optional private offsite backups (AWS S3 or R2). Configure bucket lifecycle retention separately.
GF_BACKUP_BUCKET=
GF_BACKUP_REGION=ap-northeast-2
GF_BACKUP_ENDPOINT=
GF_BACKUP_ACCESS_KEY_ID=
GF_BACKUP_SECRET_ACCESS_KEY=
