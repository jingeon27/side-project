{
	email {$GF_TLS_EMAIL}
	admin off
}

{$GF_DOMAIN} {
	request_body {
		max_size 27MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}
	# Same edge block as deploy/shared-instance/Caddyfile. Case-insensitive because path matchers are, and
	# `route` keeps the block ahead of `handle` (Caddy otherwise orders `respond` after `handle`).
	@internal path_regexp internal (?i)^/(?:_internal(?:/|$)|api/auth/(?:demo|test-)|api/admin(?:/|$))
	route {
		respond @internal "edge-blocked" 404
		handle /api/* {
			reverse_proxy api:4300 {
				flush_interval -1
			}
		}
		handle {
			reverse_proxy web:3300 {
				flush_interval -1
			}
		}
	}
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}
}
