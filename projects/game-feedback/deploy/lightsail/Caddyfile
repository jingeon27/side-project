{
	email {$GF_TLS_EMAIL}
	admin off
}

{$GF_DOMAIN} {
	request_body {
		max_size 27MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}
	@localAuth path /api/auth/demo /api/auth/test-* /api/auth/test-accounts
	respond @localAuth 404
	@internal path /internal /internal/*
	respond @internal 404
	handle /api/* {
		reverse_proxy api:4300 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:3300 {
			flush_interval -1
		}
	}
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}
}
